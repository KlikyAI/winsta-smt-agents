    "name": "Winsta AI - Public Prompts API",
    "description": "Official Postman Collection for Winsta AI Studio's Public Prompts GET API. Access validated 6-modality prompt packages and system health endpoints without authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://bookmind.my.id",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Public Prompts - List All (Default)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/public/prompts?page=1&page_size=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "public",
            "prompts"
          ],
          "query": [
            {
              "key": "page",
              "value": "1",
              "description": "Page number (starting from 1)"
            },
            {
              "key": "page_size",
              "value": "20",
              "description": "Number of items per page (1 - 100)"
            }
          ]
        },
        "description": "Fetches a paginated list of validated, integration-ready prompt packages without requiring authentication."
      },
      "response": []
    },
    {
      "name": "2. Public Prompts - Filter by Category",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/public/prompts?category=tech_ai&sort=quality_desc&page=1&page_size=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "public",
            "prompts"
          ],
          "query": [
            {
              "key": "category",
              "value": "tech_ai",
              "description": "Category slug filter (e.g. tech_ai, interior_architecture, beauty_skincare, luxury_lifestyle)"
            },
            {
              "key": "sort",
              "value": "quality_desc",
              "description": "Sorting criteria: newest | oldest | quality_desc"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "page_size",
              "value": "10"
            }
          ]
        },
        "description": "Retrieves prompt packages filtered by category, sorted by highest AI quality score."
      },
      "response": []
    },
    {
