# Application
APP_ENV=development
APP_NAME=prompt-trends-automation
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
# Supabase transaction-mode pooler for API/Celery runtime.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?ssl=require&prepared_statement_cache_size=0
DATABASE_URL_SYNC=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
DIRECT_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?ssl=require&prepared_statement_cache_size=0

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# Multi-Provider AI / LLM Engine (OpenAI, Claude, Gemini, DeepSeek, Groq, Ollama)
# -----------------------------------------------------------------------------
# Multi-Provider AI / LLM Configuration
AI_PROVIDER=deepseek  # deepseek | openai | anthropic | gemini | groq | ollama | openrouter | mistral
AI_MODEL=deepseek-chat
AI_FALLBACK_PROVIDER=openai
AI_FALLBACK_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60

# Provider-Specific API Keys & Custom Endpoints
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1

# Cloudflare Workers AI (FLUX preview generation; use a freshly rotated token)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_FLUX_STEPS=4

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_BASE=https://api.anthropic.com/v1

GEMINI_API_KEY=AIzaSy...
GOOGLE_API_KEY=AIzaSy...

GROQ_API_KEY=gsk_...
GROQ_API_BASE=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=sk-or-...
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Groq Cloud API Key (LLaMA 3.3 70B, Mixtral)
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Mistral AI API Key
MISTRAL_API_KEY=
MISTRAL_API_BASE=https://api.mistral.ai/v1

# Ollama Local / Private Server
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# OAuth 2.0 Platform Credentials (Auto Token Management)
# -----------------------------------------------------------------------------

# Meta (Instagram Graph API)
META_CLIENT_ID=
META_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# Threads API (use the Threads App ID/Secret, not Facebook or Instagram credentials)
THREADS_APP_ID=
THREADS_APP_SECRET=

# TikTok for Developers / Research API
TIKTOK_ENVIRONMENT=production
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SANDBOX_CLIENT_KEY=
TIKTOK_SANDBOX_CLIENT_SECRET=
# Comma-separated scopes. Sandbox can start with user.info.basic; add
# video.publish after Content Posting API access is enabled/approved.
TIKTOK_OAUTH_SCOPES=user.info.basic,video.publish
TIKTOK_ACCESS_TOKEN=

# X (Twitter API v2)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=

# Google & YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
GOOGLE_TRENDS_API_KEY=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202608

# Supabase Storage (use SUPABASE_SECRET_KEY or the legacy service role key, server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=social-media-assets
SUPABASE_TREND_REFERENCE_BUCKET=trend-reference-images
SUPABASE_SIGNED_URL_TTL_SECONDS=604800

# Public backend base URL used to build provider callback URLs.
SOCIAL_OAUTH_CALLBACK_BASE_URL=http://localhost:8005
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_FRONTEND_BASE_URL=http://localhost:3005
META_GRAPH_API_VERSION=v25.0

# -----------------------------------------------------------------------------
# Integration Endpoints (Downstream Delivery)
# -----------------------------------------------------------------------------
SARAH_AGENT_BASE_URL=
SARAH_AGENT_API_KEY=
SOCIAL_MEDIA_AGENT_BASE_URL=
SOCIAL_MEDIA_AGENT_API_KEY=

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Scoring Defaults
SCORING_THRESHOLD=70.0

# Trend Discovery Defaults
DEFAULT_LIMIT_PER_SOURCE=100
DISCOVERY_SCHEDULE_ENABLED=true
DISCOVERY_SCHEDULE_MINUTES=60
DISCOVERY_SCHEDULE_COUNTRY=ID
DISCOVERY_SCHEDULE_CATEGORY=beauty_skincare
DISCOVERY_SCHEDULE_AESTHETIC=minimalist_organic
DISCOVERY_SCHEDULE_TIME_WINDOW=24h
DISCOVERY_SCHEDULE_SOURCES=google_trends,tiktok,instagram,youtube,x,linkedin
