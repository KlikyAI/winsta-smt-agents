# Backend API Base URL
# - In local development: Leave blank to route through Vite proxy (proxies /api -> http://localhost:8000)
# - In production / staging: Set full URL e.g. https://api.winsta.ai
VITE_API_URL=

# Application Info
VITE_APP_NAME="Winsta AI Studio"
VITE_APP_VERSION="2.4.0"
VITE_APP_ENV="development"

